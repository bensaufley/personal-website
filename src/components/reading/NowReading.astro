---
import { getCollection } from 'astro:content';
import dayjs from 'dayjs';
import utc from 'dayjs/plugin/utc';

import { coverUrl } from '../../lib/covers';

import styles from './styles.module.css';

dayjs.extend(utc);

const allBooks = (await getCollection('books', (book) => !book.data.finishedAt && !!book.data.startedAt)).toSorted(
  (a, b) => dayjs.utc(b.data.startedAt).diff(a.data.startedAt, 'day'),
);
---

<section class={styles.nowReading}>
  <header>
    <h3>Now Reading</h3>
  </header>
  <ul>
    {
      allBooks.map((book) => {
        const href = book.data.storygraphId
          ? `https://app.thestorygraph.com/books/${book.data.storygraphId}`
          : undefined;
        const cover = coverUrl(book.data.coverImage);
        const Wrap = href ? 'a' : 'span';
        const wrapProps = href ? { href, target: '_blank', rel: 'noopener' } : {};
        return (
          <li class={styles.book}>
            <Wrap class={styles.cover} {...wrapProps}>
              {cover ? (
                <object data={cover} type="image/jpeg" class={styles.coverImage}>
                  {/* TODO: cover placeholder element */}
                  {book.data.title}
                </object>
              ) : (
                <span>
                  {/* TODO: cover placeholder element */}
                  {book.data.title}
                </span>
              )}
            </Wrap>
          </li>
        );
      })
    }
  </ul>
</section>
