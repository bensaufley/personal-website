---
import { getCollection } from 'astro:content';
import dayjs from 'dayjs';
import utc from 'dayjs/plugin/utc';

import { coverUrl } from '../../lib/covers';

import styles from './styles.module.css';

dayjs.extend(utc);

const allBooks = (await getCollection('books', (book) => !book.data.startedAt && !book.data.finishedAt)).toSorted(
  (a, b) => a.data.title.localeCompare(b.data.title),
);
---

<section class={styles.upNext}>
  <header>
    <h3>Up Next</h3>
    <p>In no particular order</p>
  </header>
  <ul>
    {
      allBooks.map((book) => {
        const href = book.data.storygraphUrl ?? undefined;
        const cover = coverUrl(book.data.coverImage) ?? book.data.coverImageUrl;
        const Wrap = href ? 'a' : 'span';
        const wrapProps = href ? { href, target: '_blank', rel: 'noopener' } : {};
        return (
          <li class={styles.book}>
            <Wrap class={styles.cover} {...wrapProps}>
              {cover ? (
                <object data={cover} type="image/jpeg" class={styles.coverImage}>
                  {/* TODO: cover placeholder element */}
                  {book.data.title}
                </object>
              ) : (
                <span>
                  {/* TODO: cover placeholder element */}
                  {book.data.title}
                </span>
              )}
            </Wrap>
          </li>
        );
      })
    }
  </ul>
</section>
